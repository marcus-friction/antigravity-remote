{
  "expo": {
    "name": "Antigravity Remote",
    "slug": "antigravity-remote",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "antigravity-remote",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frictionventures.antigravity-remote",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frictionventures.antigravityremote",
      "allowBackup": false,
      "versionCode": 6,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121417"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow Antigravity Remote to securely access your persisted session cookies."
        }
      ],
      "expo-asset",
      "expo-system-ui",
      "./plugins/withRemoteSecurity"
    ]
  }
}
