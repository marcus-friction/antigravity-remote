{
  "name": "antigravity-remote",
  "version": "1.0.5",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-build-tools.js",
    "start": "node scripts/patch-build-tools.js --check && expo start --localhost",
    "android": "node scripts/patch-build-tools.js --check && expo run:android",
    "ios": "node scripts/patch-build-tools.js --check && expo run:ios",
    "web": "node scripts/patch-build-tools.js --check && expo start --web",
    "prebuild": "node scripts/patch-build-tools.js --check && expo prebuild",
    "build:play-aab": "node scripts/patch-build-tools.js --check && node scripts/check-native.js && cd android && ./gradlew bundleRelease && python3 ../scripts/check-16kb.py app/build/outputs/bundle/release/app-release.aab",
    "publish:play-internal": "npm run build:play-aab && cd android && ./gradlew publishReleaseBundle",
    "publish:play-production": "npm run build:play-aab && cd android && PLAY_TRACK=production ./gradlew publishReleaseListing publishReleaseBundle",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:prebuild": "node scripts/test-prebuild.js",
    "audit:dependencies": "node scripts/audit-dependencies.js",
    "check:build-tools": "node scripts/patch-build-tools.js --check",
    "check:native": "node scripts/check-native.js",
    "check:16kb": "python3 scripts/check-16kb.py"
  },
  "dependencies": {
    "@preeternal/react-native-cookie-manager": "7.0.0",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-linking": "~55.0.17",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "node-forge": "1.4.0"
  }
}
